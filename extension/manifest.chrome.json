{
  "manifest_version": 3,
  "name": "Cyberpunk Pro New Tab Dashboard",
  "version": "1.0.0",
  "description": "High-performance Cyberpunk HUD New Tab Dashboard with customizable widgets, bookmarks, developer tools, and productivity suite.",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "storage",
    "bookmarks",
    "tabs",
    "identity"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
